<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef Name="HET_AnimalOrganBase" ParentName="BodyPartBase" Abstract="True">
    <thingClass>Harvest_Everything.Thing_AnimalOrgan</thingClass>
    <graphicData>
      <texPath>Things/Item/Health/HealthItem</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.80</drawSize>
      <color>(196,150,132)</color>
    </graphicData>
    <thingCategories>
      <li>BodyPartsNatural</li>
    </thingCategories>
    <statBases>
      <DeteriorationRate>4.0</DeteriorationRate>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalHeart</defName>
    <label>animal heart</label>
    <description>A muscular organ that pumps blood through the body.</description>
    <statBases>
      <MarketValue>350</MarketValue>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalLung</defName>
    <label>animal lung</label>
    <description>A breathing organ that draws oxygen into the blood.</description>
    <statBases>
      <MarketValue>300</MarketValue>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalKidney</defName>
    <label>animal kidney</label>
    <description>An organ that filters waste from the blood.</description>
    <statBases>
      <MarketValue>250</MarketValue>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalLiver</defName>
    <label>animal liver</label>
    <description>An organ that processes nutrients and breaks down toxins.</description>
    <statBases>
      <MarketValue>350</MarketValue>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalStomach</defName>
    <label>animal stomach</label>
    <description>A muscular pouch that breaks down food.</description>
    <statBases>
      <MarketValue>200</MarketValue>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalBrain</defName>
    <label>animal brain</label>
    <description>The organ that controls thought, movement and the senses.</description>
    <statBases>
      <MarketValue>400</MarketValue>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalTail</defName>
    <label>animal tail</label>
    <description>An animal's tail, used for balance, movement or communication.</description>
    <statBases>
      <MarketValue>250</MarketValue>
      <Mass>1</Mass>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalPaw</defName>
    <label>animal paw</label>
    <description>The end of an animal's limb, used for support and movement.</description>
    <statBases>
      <MarketValue>60</MarketValue>
      <Mass>0.4</Mass>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalClaw</defName>
    <label>animal claw</label>
    <description>A small part from the end of an animal's limb.</description>
    <statBases>
      <MarketValue>12</MarketValue>
      <Mass>0.05</Mass>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalHoof</defName>
    <label>animal hoof</label>
    <description>A hard covering that protects the end of an animal's foot.</description>
    <statBases>
      <MarketValue>18</MarketValue>
      <Mass>0.2</Mass>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalHorn</defName>
    <label>animal horn</label>
    <description>A hard growth used for defense or display.</description>
    <statBases>
      <MarketValue>50</MarketValue>
      <Mass>0.5</Mass>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalBeak</defName>
    <label>animal beak</label>
    <description>A hard structure used for feeding or defense.</description>
    <statBases>
      <MarketValue>40</MarketValue>
      <Mass>0.3</Mass>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalWing</defName>
    <label>animal wing</label>
    <description>A limb shaped for flight or gliding.</description>
    <statBases>
      <MarketValue>80</MarketValue>
      <Mass>0.8</Mass>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalShell</defName>
    <label>animal shell</label>
    <description>A hard outer covering that protects the body.</description>
    <statBases>
      <MarketValue>100</MarketValue>
      <Mass>1</Mass>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="HET_AnimalOrganBase">
    <defName>HET_AnimalTentacle</defName>
    <label>animal tentacle</label>
    <description>A flexible limb used to grasp, feel or move.</description>
    <statBases>
      <MarketValue>40</MarketValue>
      <Mass>0.4</Mass>
    </statBases>
  </ThingDef>
  <RecipeDef ParentName="SurgeryInstallBodyPartNaturalBase">
    <defName>HET_InstallAnimalTail</defName>
    <label>install tail</label>
    <description>Install a tail recovered from an animal into a compatible tail body part.</description>
    <jobString>Installing natural tail.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>HET_AnimalTail</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>HET_AnimalTail</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Tail</li>
    </appliedOnFixedBodyParts>
    <recipeUsers Inherit="False" />
  </RecipeDef>
  <RecipeDef ParentName="SurgeryInstallBodyPartNaturalBase">
    <defName>HET_InstallAnimalPart</defName>
    <label>install animal part</label>
    <description>Replace a damaged or missing part using the same body part from the same animal species.</description>
    <jobString>Transplanting animal part.</jobString>
    <workerClass>Harvest_Everything.Recipe_InstallAnimalPart</workerClass>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>HET_AnimalHeart</li>
            <li>HET_AnimalLung</li>
            <li>HET_AnimalKidney</li>
            <li>HET_AnimalLiver</li>
            <li>HET_AnimalStomach</li>
            <li>HET_AnimalBrain</li>
            <li>HET_AnimalPaw</li>
            <li>HET_AnimalClaw</li>
            <li>HET_AnimalHoof</li>
            <li>HET_AnimalHorn</li>
            <li>HET_AnimalBeak</li>
            <li>HET_AnimalWing</li>
            <li>HET_AnimalShell</li>
            <li>HET_AnimalTentacle</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>HET_AnimalHeart</li>
        <li>HET_AnimalLung</li>
        <li>HET_AnimalKidney</li>
        <li>HET_AnimalLiver</li>
        <li>HET_AnimalStomach</li>
        <li>HET_AnimalBrain</li>
        <li>HET_AnimalPaw</li>
        <li>HET_AnimalClaw</li>
        <li>HET_AnimalHoof</li>
        <li>HET_AnimalHorn</li>
        <li>HET_AnimalBeak</li>
        <li>HET_AnimalWing</li>
        <li>HET_AnimalShell</li>
        <li>HET_AnimalTentacle</li>
      </thingDefs>
    </fixedIngredientFilter>
    <recipeUsers Inherit="False" />
  </RecipeDef>
</Defs>