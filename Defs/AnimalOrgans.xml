    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>HET_AnimalHeart</li>
        <li>HET_AnimalLung</li>
        <li>HET_AnimalKidney</li>
        <li>HET_AnimalLiver</li>
