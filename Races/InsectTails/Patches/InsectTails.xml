<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!-- Insect tails supplied by race mods (def-driven fallback) -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BodyPartDef[defName="InsectTail"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HATT17_InsectTail"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
              <ThingDef ParentName="BodyPartNaturalBase">
                <defName>HATT17_InsectTail</defName>
                <label>tail (natural)</label>
                <description>A natural tail. Transplantable into humanoid races with the matching anatomical tail type.</description>
                <statBases>
                  <MarketValue>250</MarketValue>
                  <Mass>2</Mass>
                </statBases>
              </ThingDef>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/BodyPartDef[defName="InsectTail"]/spawnThingOnRemoved</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/BodyPartDef[defName="InsectTail"]</xpath>
            <value>
              <spawnThingOnRemoved>HATT17_InsectTail</spawnThingOnRemoved>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/RecipeDef[defName="HATT17_Install_InsectTail"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
              <RecipeDef ParentName="SurgeryInstallBodyPartNaturalBase">
                <defName>HATT17_Install_InsectTail</defName>
                <label>install natural tail</label>
                <jobString>Installing natural tail.</jobString>
                <ingredients>
                  <li>
                    <filter>
                      <thingDefs>
                        <li>HATT17_InsectTail</li>
                      </thingDefs>
                    </filter>
                    <count>1</count>
                  </li>
                </ingredients>
                <fixedIngredientFilter>
                  <thingDefs>
                    <li>HATT17_InsectTail</li>
                  </thingDefs>
                </fixedIngredientFilter>
                <appliedOnFixedBodyParts>
                  <li>InsectTail</li>
                </appliedOnFixedBodyParts>
                <recipeUsers Inherit="False" />
              </RecipeDef>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/RecipeDef[defName="HATT17_Remove_InsectTail"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
              <RecipeDef ParentName="SurgeryFlesh">
                <defName>HATT17_Remove_InsectTail</defName>
                <label>remove natural tail</label>
                <jobString>Removing natural tail.</jobString>
                <workerClass>Recipe_RemoveBodyPart</workerClass>
                <workAmount>400</workAmount>
                <surgerySuccessChanceFactor>1</surgerySuccessChanceFactor>
                <appliedOnFixedBodyParts>
                  <li>InsectTail</li>
                </appliedOnFixedBodyParts>
                <recipeUsers Inherit="False" />
              </RecipeDef>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
