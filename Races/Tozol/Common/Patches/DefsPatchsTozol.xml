<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!-- Tozol tail -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BodyPartDef[defName="Tozol_Tail"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HATT17_Tozol_Tail"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
              <ThingDef ParentName="BodyPartNaturalBase">
                <defName>HATT17_Tozol_Tail</defName>
                <label>tail (natural)</label>
                <description>A natural tail. Transplantable into humanoid races with the matching anatomical tail type.</description>
                <statBases>
                  <MarketValue>250</MarketValue>
                  <Mass>2</Mass>
                </statBases>
              </ThingDef>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/BodyPartDef[defName="Tozol_Tail"]/spawnThingOnRemoved</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/BodyPartDef[defName="Tozol_Tail"]</xpath>
            <value>
              <spawnThingOnRemoved>HATT17_Tozol_Tail</spawnThingOnRemoved>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/RecipeDef[defName="HATT17_Install_Tozol_Tail"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
              <RecipeDef ParentName="SurgeryInstallBodyPartNaturalBase">
                <defName>HATT17_Install_Tozol_Tail</defName>
                <label>install natural tails</label>
                <jobString>Installing natural tail.</jobString>
                <ingredients>
                  <li>
                    <filter>
                      <thingDefs>
                        <li>HATT17_Tozol_Tail</li>
                      </thingDefs>
                    </filter>
                    <count>1</count>
                  </li>
                </ingredients>
                <fixedIngredientFilter>
                  <thingDefs>
                    <li>HATT17_Tozol_Tail</li>
                  </thingDefs>
                </fixedIngredientFilter>
                <appliedOnFixedBodyParts>
                  <li>Tozol_Tail</li>
                </appliedOnFixedBodyParts>
                <recipeUsers Inherit="False" />
              </RecipeDef>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/RecipeDef[defName="HATT17_Remove_Tozol_Tail"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
              <RecipeDef ParentName="SurgeryFlesh">
                <defName>HATT17_Remove_Tozol_Tail</defName>
                <label>remove natural tails</label>
                <jobString>Removing natural tail.</jobString>
                <workerClass>Recipe_RemoveBodyPart</workerClass>
                <workAmount>400</workAmount>
                <surgerySuccessChanceFactor>1</surgerySuccessChanceFactor>
                <appliedOnFixedBodyParts>
                  <li>Tozol_Tail</li>
                </appliedOnFixedBodyParts>
                <recipeUsers Inherit="False" />
              </RecipeDef>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
